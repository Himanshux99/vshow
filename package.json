{
  "name": "vshow",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset:local": "node --disable-warning=ExperimentalWarning scripts/db-reset-local.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/db-seed.ts",
    "db:health": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/db-health.ts",
    "test": "node scripts/run-tests.mjs",
    "test:ci": "node scripts/run-tests.mjs --fail-on-skip"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.3"
  }
}

# Created automatically by `npm run setup`. Placeholders only - never commit real values.

# Environment designation. Seeding only runs when this is "development" or "test".
APP_ENV=development

# Database target: "local" (Docker Compose Postgres) or "neon" (existing Neon database).
DB_TARGET=local

# --- Local Postgres (used when DB_TARGET=local). Password is generated by setup.
POSTGRES_USER=vshow
POSTGRES_DB=vshow
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me

# Runtime connection. Local: generated by setup. Neon: the POOLED string (host contains "-pooler"),
# e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# Neon only: the DIRECT (non-pooled) string, used by `npm run db:migrate`. Leave empty for local.
DATABASE_URL_DIRECT=

# --- Auth session secret (generated by setup)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:5173

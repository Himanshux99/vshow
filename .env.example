# Created automatically by `npm run setup`. Placeholders only - never commit real values.

# Environment designation. Seeding only runs when this is "development" or "test".
APP_ENV=development

# Database target: "local" (Docker Compose Postgres) or "neon" (existing Neon database).
DB_TARGET=local

# --- Local Postgres (used when DB_TARGET=local). Password is generated by setup.
POSTGRES_USER=vshow
POSTGRES_DB=vshow
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me

# Runtime connection. Local: generated by setup. Neon: the POOLED string (host contains "-pooler"),
# e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# Neon only: the DIRECT (non-pooled) string, used by `npm run db:migrate`. Leave empty for local.
DATABASE_URL_DIRECT=

# --- Authentication (VOSS vauth through Better Auth) ---
# Session/cookie signing secret (generated by setup; use a DIFFERENT value per environment).
BETTER_AUTH_SECRET=change-me
# Vshow's own origin, no path or trailing slash. Local: http://localhost:5173 (the port is pinned).
# Production must be exactly https://vshow.vosslabs.org.
BETTER_AUTH_URL=http://localhost:5173
# vauth discovery URL (fixed; production validates that it is exactly this value).
VOSS_DISCOVERY_URL=https://accounts.vosslabs.org/api/auth/.well-known/openid-configuration
# Issued by the vauth maintainers after Vshow is registered. Obtain them privately; NEVER commit them or
# paste them into chat/issues. Use separate credentials for local development and production.
VOSS_CLIENT_ID=
VOSS_CLIENT_SECRET=
# Local development identity switcher (seeded test users). Leave EMPTY unless you want it. Setting it to 1 is
# honoured only when APP_ENV=development, NODE_ENV is not production, Vercel variables are absent,
# BETTER_AUTH_URL is localhost and the local Compose database guard passes; otherwise the server refuses to
# start, and `npm run build` fails while it is set.
VSHOW_DEV_AUTH=

# --- Logging (optional)
# LOG_LEVEL: trace|debug|info|warn|error|fatal|silent. Default: debug in development, info in production.
LOG_LEVEL=
# LOG_FORMAT: json|pretty. Default: pretty only in an interactive, non-production terminal.
LOG_FORMAT=
